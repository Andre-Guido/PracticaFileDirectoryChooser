<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="357.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.practicafiledirectorychooser.RegistroProyectoController">
   <children>
      <VBox alignment="CENTER" layoutX="10.0" layoutY="14.0" prefHeight="291.0" prefWidth="580.0" spacing="10.0">
         <children>
            <Label contentDisplay="CENTER" text="Registro de Proyecto">
               <font>
                  <Font name="Times New Roman Bold" size="18.0" />
               </font></Label>
            <Separator prefWidth="200.0" />
            <GridPane fx:id="gridDatosProyecto" prefHeight="105.0" prefWidth="580.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="285.0" minWidth="10.0" prefWidth="131.0" />
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="449.0" minWidth="10.0" prefWidth="449.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Label text="Nombre del Proyecto:">
                     <font>
                        <Font name="Times New Roman" size="13.0" />
                     </font>
                  </Label>
                  <Label text="Responsable:" GridPane.rowIndex="1">
                     <font>
                        <Font name="Times New Roman" size="13.0" />
                     </font>
                  </Label>
                  <Label text="Descripción:" GridPane.rowIndex="2">
                     <font>
                        <Font name="Times New Roman" size="13.0" />
                     </font></Label>
                  <TextField fx:id="txtNombreProyecto" promptText="Nombre del Proyecto" GridPane.columnIndex="1">
                     <font>
                        <Font name="Times New Roman" size="13.0" />
                     </font></TextField>
                  <TextField fx:id="txtNombreResponsable" promptText="Nombre del Responsable" GridPane.columnIndex="1" GridPane.rowIndex="1">
                     <font>
                        <Font name="Times New Roman" size="13.0" />
                     </font></TextField>
                  <TextField fx:id="txtDescripcion" promptText="Descripción Breve del Proyecto" GridPane.columnIndex="1" GridPane.rowIndex="2">
                     <font>
                        <Font name="Times New Roman" size="13.0" />
                     </font>
                  </TextField>
               </children>
            </GridPane>
            <HBox alignment="CENTER" prefHeight="50.0" prefWidth="580.0" spacing="15.0">
               <children>
                  <Label text="Archivo de requerimientos:">
                     <font>
                        <Font name="Times New Roman" size="13.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtRequerimiento" editable="false" prefHeight="26.0" prefWidth="325.0" promptText="Seleccione un Archivo">
                     <font>
                        <Font name="Times New Roman" size="13.0" />
                     </font>
                  </TextField>
                  <Button fx:id="btnSeleccionarArchivo" mnemonicParsing="false" onAction="#seleccionarArchivo" text="Seleccionar">
                     <font>
                        <Font name="Times New Roman" size="13.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
            <HBox alignment="CENTER" prefHeight="42.0" prefWidth="580.0" spacing="15.0">
               <children>
                  <Label text="Directorio del Proyecto:">
                     <font>
                        <Font name="Times New Roman" size="13.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtDirectorio" editable="false" prefHeight="23.0" prefWidth="342.0" promptText="Seleccione un directorio">
                     <font>
                        <Font name="Times New Roman" size="13.0" />
                     </font>
                  </TextField>
                  <Button fx:id="btnSeleccionarDirectorio" mnemonicParsing="false" onAction="#seleccionarDirectorio" text="Seleccionar">
                     <font>
                        <Font name="Times New Roman" size="13.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
            <Separator prefWidth="200.0" />
         </children>
      </VBox>
      <HBox alignment="CENTER" layoutX="14.0" layoutY="305.0" prefHeight="35.0" prefWidth="200.0" spacing="15.0">
         <children>
            <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardarDatos" style="-fx-background-color: #6DCCEA;" text="Guardar Proyecto">
               <font>
                  <Font name="Times New Roman" size="13.0" />
               </font>
            </Button>
            <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#limpiarDatos" text="Limpiar">
               <font>
                  <Font name="Times New Roman" size="13.0" />
               </font>
            </Button>
         </children>
      </HBox>
   </children>
</AnchorPane>
